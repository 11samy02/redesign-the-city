; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Redesign the City"
config/description="A local 2-4 player city-building board game about circulation, greenery and accessibility in Egkomi."
config/version="3.0.0"
run/main_scene="res://scenes/title.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
boot_splash/bg_color=Color(0.0588235, 0.164706, 0.239216, 1)
boot_splash/show_image=false
config/icon="res://icon.svg"

[autoload]

Sfx="*res://scripts/autoload/sfx.gd"
Transition="*res://scripts/autoload/transition.gd"
Game="*res://scripts/autoload/game.gd"

[display]

window/size/viewport_width=1600
window/size/viewport_height=900
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[physics]

3d/physics_engine="Jolt Physics"

[rendering]

textures/canvas_textures/default_texture_filter=3
rendering_device/driver.windows="d3d12"
environment/defaults/default_clear_color=Color(0.0588235, 0.164706, 0.239216, 1)
